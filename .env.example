GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# postgres uses the database; json keeps the earlier local prototype.
SHOP_STORAGE=postgres
POSTGRES_DB=bobaops
POSTGRES_USER=bobaops
# Local Docker database uses trust authentication; no password needed.
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Optional hosted PostgreSQL URL; overrides POSTGRES_HOST/PORT/USER/PASSWORD/DB.
# Use the provider's direct connection or session pooler (not a transaction pooler).
DATABASE_URL=
# Hosted connections: require, or verify-full with the provider's CA certificate.
POSTGRES_SSLMODE=
POSTGRES_SSLROOTCERT=
# Optional local Docker app port; keep 8000 available for your other project.
APP_PORT=8006
# Keep local for Docker on your Mac; use supabase on Render Free.
RECEIPT_STORAGE=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=receipts
# Optional Docker browser pgAdmin; not needed for the Mac pgAdmin app.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace_with_another_local_password

# Timezone for recorded waste/count timestamps in analytics.
# Use Asia/Ho_Chi_Minh for Vietnam shop-local reporting.
SHOP_TIMEZONE=Asia/Singapore

# Optional API key for the chat assistant.
OPENROUTER_API_KEY=

# Chat only: free router, or an explicit model ID ending in :free.
OPENROUTER_MODEL=openrouter/free

# Run python3 -m scripts.setup_login to generate these locally. Never store a plaintext password.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
# false for http://127.0.0.1 locally; true behind HTTPS when deployed.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=28800
# Optional exact public origin, e.g. https://shop.example.com (no trailing slash).
AUTH_ALLOWED_ORIGIN=
