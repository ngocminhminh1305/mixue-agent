{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft sales report extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "items",
    "issues"
  ],
  "properties": {
    "date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_name",
          "quantity",
          "issues"
        ],
        "properties": {
          "item_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
